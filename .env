# Hearthborn server settings. Read by server/db.mjs (dev server and npm start).
# MongoDB runs locally in Docker: npm run db  (container port 27017 -> 27018 on this machine).
MONGO_URL=mongodb://127.0.0.1:27018
MONGO_DB=hearthborn
# Only requests on these ports use the real save database; every other port uses hearthborn_test.
HB_SAVE_PORTS=5173
